{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User statistics, settings, and unlocks",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "level": { "type": "number" },
        "exp": { "type": "number" },
        "score": { "type": "number" },
        "totalExp": { "type": "number" },
        "bio": { "type": "string" },
        "gamesPlayed": { "type": "number" },
        "currentCharacter": { "type": "string" },
        "currentFrame": { "type": "string" },
        "currentTheme": { "type": "string" },
        "unlockedThemes": { "type": "array" },
        "unlockedFrames": { "type": "array" },
        "unlockedCharacters": { "type": "array" },
        "unlockedBadges": { "type": "array" },
        "favorites": { "type": "array" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "isAdmin": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "settings": { "type": "object" }
      },
      "required": ["uid", "username"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Global chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "username": { "type": "string" },
        "recipientUid": { "type": "string" },
        "recipientUsername": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "character": { "type": "string" },
        "frame": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "customAvatar": { "type": "string" }
      },
      "required": ["text", "senderUid"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global announcement or event",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "type": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "timestamp"]
    },
    "GlobalSettings": {
      "title": "Global Settings",
      "description": "Site-wide configuration",
      "type": "object",
      "properties": {
        "isMaintenanceMode": { "type": "boolean" },
        "gameOfTheWeekId": { "type": "string" },
        "gameOfTheWeekName": { "type": "string" },
        "lockedGames": { "type": "object" },
        "includeOwnerInLeaderboard": { "type": "boolean" }
      }
    },
    "Suggestion": {
      "title": "Player Suggestion",
      "description": "Player feature suggestion with voting",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorCharacter": { "type": "string" },
        "votes": { "type": "number" },
        "voters": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["text", "authorId", "authorName", "votes"]
    },
    "Report": {
      "title": "Report",
      "description": "Report for broken games or account rule violations",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetEmail": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "reportedByUid": { "type": "string" },
        "reportedByName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "targetId", "targetName", "reportedByUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user document indexed by UID"
    },
    "/chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global chat messages"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global announcements"
    },
    "/suggestions/{suggestionId}": {
      "schema": "Suggestion",
      "description": "Player suggestions"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Reports submitted by players for broken games or accounts"
    },
    "/settings/global": {
      "schema": "GlobalSettings",
      "description": "Global site settings"
    },
    "/admins/{userId}": {
      "schema": "object",
      "description": "Admin allowlist"
    },
    "/deleted_emails/{email}": {
      "schema": "object",
      "description": "Terminated accounts blocked email registry"
    }
  }
}
